#!/bin/bash
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release --locked

name=$(scripts/brand-plist --const NAME)
exe=$(scripts/brand-plist --const EXECUTABLE)
app="$HOME/Applications/$(scripts/brand-plist --const BUNDLE)"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# Replace atomically so installing does not interrupt a running Apollo.
cp target/release/herdr-app "$app/Contents/MacOS/$exe.new"
mv -f "$app/Contents/MacOS/$exe.new" "$app/Contents/MacOS/$exe"
chmod +x "$app/Contents/MacOS/$exe"
cp assets/icons/Apollo.icns "$app/Contents/Resources/Apollo.icns"

scripts/brand-plist "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" > "$app/Contents/Info.plist"
# Finder does not inherit a login shell's PATH; hc must still be discoverable.
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen $name to use the new build."
