#!/bin/bash
# Points ~/.local/bin/herdr-app at this checkout's release build and adds the
# launcher entry with the Apollo icon. Re-run after moving the checkout.
set -euo pipefail

[[ $(uname -s) == Linux ]] || { echo 'This installer is for Linux.' >&2; exit 1; }
cd "$(dirname "$0")/.."
cargo build --release

# The window's app id (Wayland app_id, X11 WM_CLASS) is APP_ID: the entry is named after it
# and claims it, so the running window groups under this launcher and its icon.
name=$(scripts/brand-plist --const NAME)
id=$(scripts/brand-plist --const APP_ID)
data=${XDG_DATA_HOME:-$HOME/.local/share}
mkdir -p "$HOME/.local/bin" "$data/applications" "$data/icons/hicolor/scalable/apps"
ln -sfn "$PWD/target/release/herdr-app" "$HOME/.local/bin/herdr-app"
cp assets/icons/apollo.svg "$data/icons/hicolor/scalable/apps/$id.svg"
cat > "$data/applications/$id.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=Terminals and coding agents that keep running
Exec=$HOME/.local/bin/herdr-app
Icon=$id
Terminal=false
Categories=Development;
StartupWMClass=$id
EOF
update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[[ -f $data/icons/hicolor/icon-theme.cache ]] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true
echo "Installed $name (herdr-app). Quit and reopen $name to use the new build."
