#!/bin/bash
# Builds a release of Apollo for this machine and zips it:
#
#   scripts/package            -> dist/apollo-app-<version>-<os>-<arch>.zip
#   scripts/package <triple>   -> the same for another supported Rust target
#
# macOS: Apollo.app, signed with APPLE_CERTIFICATE_P12 when available,
# otherwise ad hoc (scripts/mac-sign).
# Windows (Git Bash): an apollo-app folder holding apollo-app.exe, herdr-app.exe
# (the same binary, so `herdr-app …` works with the folder on PATH) and the icon.
# No core inside: the app installs herdr-core's own release
# (distribution/core-version is the oldest core this app works with).
# The app never updates itself; new versions come from the Releases page.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)

triple=${1:-}
if [[ -n $triple ]]; then
  case "$triple" in
    *-linux-*) os=linux ;;
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *) echo "package: unsupported target $triple" >&2; exit 1 ;;
  esac
  arch=${triple%%-*}
  bin=target/$triple/release
else
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    MINGW* | MSYS* | CYGWIN*) os=windows ;;
    *) echo "package: unsupported OS $(uname -s)" >&2; exit 1 ;;
  esac
  arch=$(uname -m)
  bin=target/release
fi
case "$arch" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "package: unsupported CPU $arch" >&2; exit 1 ;;
esac
if [[ $os == linux ]]; then
  echo "package: only macOS and Windows ship" >&2
  exit 1
fi

root=$(pwd)
name=$(scripts/brand-plist --const NAME)
exe=$(scripts/brand-plist --const EXECUTABLE)
out="$root/dist/apollo-app-$version-$os-$arch.zip"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

echo "package: $name $version for $os-$arch"
for notice in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $notice ]] || { echo "package: $notice is missing or empty" >&2; exit 1; }
done
# APOLLO_RELEASE lets the app check and update herdr-core (src/update.rs).
APOLLO_RELEASE=1 cargo build --release --locked ${triple:+--target "$triple"}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist
# Both 7z and ditto would add to an existing archive.
rm -f "$out"
if [[ $os == windows ]]; then
  dir="$work/apollo-app"
  mkdir -p "$dir"
  cp "$bin/herdr-app.exe" "$dir/apollo-app.exe"
  cp "$bin/herdr-app.exe" "$dir/herdr-app.exe"
  cmp "$dir/apollo-app.exe" "$dir/herdr-app.exe"
  cp assets/icons/apollo.svg "$dir/apollo-app.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  cmp "$dir/THIRD-PARTY-NOTICES" THIRD-PARTY-NOTICES
  (cd "$work" && 7z a -tzip "$out" apollo-app >/dev/null)
else
  app="$work/$name.app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$bin/herdr-app" "$app/Contents/MacOS/$exe"
  cp assets/icons/Apollo.icns "$app/Contents/Resources/Apollo.icns"
  cp assets/icons/Assets.car "$app/Contents/Resources/Assets.car"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  scripts/brand-plist "$version" > "$app/Contents/Info.plist"
  cmp "$app/Contents/Resources/THIRD-PARTY-NOTICES" THIRD-PARTY-NOTICES
  scripts/mac-sign "$app"
  ditto -c -k --sequesterRsrc --keepParent "$app" "$out"
fi
echo "package: $out ($(sha256 "$out"))"
